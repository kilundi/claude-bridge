{
  "chat_url": "https://claude.ai/chat/REPLACE-WITH-YOUR-CONVERSATION-ID",
  "watch": {
    "interval_seconds": 30,
    "auto_start": true,
    "auto_launch_bridge": false,
    "lookback": 3,
    "compact_on_resume": true,
    "launch_terminal": true,
    "default_dir": "~/projects",
    "model": {
      "providerID": "your-provider",
      "id": "your-model"
    },
    "opencode_bin": "~/.opencode/bin/opencode",
    "ask_for_order": true,
    "ask_max_streak": 1,
    "ask_grace_seconds": 600,
    "ask_min_seconds": 120,
    "ask_timeout": 180,
    "agent_active_seconds": 1800,
    "max_agents": 2,
    "slot_seconds": 3600,
    "service_start_cooldown": 60,
    "resume_interrupted": true,
    "resume_max": 3,
    "resume_max_per_pass": 2,
    "resume_cooldown_seconds": 1800,
    "resume_max_age_seconds": 21600,
    "reap_idle_seconds": 7200
  }
}
