{
  "chat_url": "https://claude.ai/chat/REPLACE-WITH-YOUR-CONVERSATION-ID",
  "watch": {
    "interval_seconds": 30,
    "auto_start": true,
    "auto_launch_bridge": false,
    "lookback": 3,
    "compact_on_resume": true,
    "launch_terminal": true,
    "default_dir": "~/projects",
    "model": { "providerID": "your-provider", "id": "your-model" },
    "opencode_bin": "~/.opencode/bin/opencode"
  }
}
